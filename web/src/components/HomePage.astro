---
import ButtonLink from "./ButtonLink.astro";
import { tFor } from "../i18n/t";
import type { Locale } from "../i18n/types";
import Base from "../layouts/Base.astro";
import { REPOSITORY_URL } from "../lib/links";
import GitHubIcon from "./icons/GitHubIcon.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = tFor(locale);
---

{/* Placeholder until Phase 3 (docs/specs/web/features/top-page.md). */}
<Base
  locale={locale}
  page="home"
  title={t("home.title")}
  description={t("site.description")}
>
  <section class="flex flex-col items-start gap-6 py-12">
    <div class="flex flex-col gap-3">
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
        {t("site.name")}
      </h1>
      <p class="text-xl text-muted-foreground">{t("site.tagline")}</p>
    </div>
    <p class="max-w-prose text-base">{t("site.description")}</p>
    <ButtonLink href={REPOSITORY_URL}>
      <GitHubIcon class="size-4" />
      {t("home.github")}
    </ButtonLink>
  </section>
</Base>
