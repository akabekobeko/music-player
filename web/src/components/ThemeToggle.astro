---
import Moon from "lucide-static/icons/moon.svg";
import Sun from "lucide-static/icons/sun.svg";
import { tFor } from "../i18n/t";
import type { Locale } from "../i18n/types";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = tFor(locale);
---

{/*
  Light / Dark toggle (docs/specs/web/architecture/theme.md). `aria-pressed`
  reflects the dark theme; the icon follows the `.dark` class on <html>, so it
  is right from the first paint without JavaScript. The button stays in place
  when JavaScript is off: the page then simply follows the OS setting.
*/}
<button
  type="button"
  data-theme-toggle
  class="inline-flex size-8 items-center justify-center rounded-full text-foreground transition-glow hover:glow-lamp"
  aria-label={t("header.theme")}
  aria-pressed="false"
>
  <Sun class="size-5 dark:hidden" aria-hidden="true" />
  <Moon class="hidden size-5 dark:block" aria-hidden="true" />
</button>

<script>
  const STORAGE_KEY = "theme";
  const root = document.documentElement;
  const query = window.matchMedia("(prefers-color-scheme: dark)");

  const storedTheme = (): string | null => {
    try {
      return localStorage.getItem(STORAGE_KEY);
    } catch {
      return null;
    }
  };

  const apply = (dark: boolean): void => {
    root.classList.toggle("dark", dark);
    for (const button of document.querySelectorAll("[data-theme-toggle]")) {
      button.setAttribute("aria-pressed", String(dark));
    }
  };

  // The inline script in <head> has already set `.dark`; sync aria-pressed.
  apply(root.classList.contains("dark"));

  for (const button of document.querySelectorAll("[data-theme-toggle]")) {
    button.addEventListener("click", () => {
      const dark = !root.classList.contains("dark");
      try {
        localStorage.setItem(STORAGE_KEY, dark ? "dark" : "light");
      } catch {
        // Private mode or storage disabled: the choice lasts for this page only.
      }
      apply(dark);
    });
  }

  // Follow the OS only while the visitor has not chosen a theme (same as the
  // app's watchSystemTheme).
  query.addEventListener("change", (event) => {
    if (storedTheme() === null) {
      apply(event.matches);
    }
  });
</script>
