---
import { getRelativeLocaleUrl } from "astro:i18n";
import { tFor } from "../i18n/t";
import type { Locale } from "../i18n/types";

interface Props {
  locale: Locale;
  /** Route path of the current page relative to the locale root. */
  path: string;
}
const { locale, path } = Astro.props;
const t = tFor(locale);
const other: Locale = locale === "en" ? "ja" : "en";
---

{/*
  Plain link to the same page in the other language, so it works without
  JavaScript. Shows the other language's name in that language; below the
  `xs` breakpoint only the short code (docs/specs/web/architecture/i18n.md).
  The "Switch to ..." hint is visually hidden text rather than an
  aria-label, so the accessible name still contains the visible label.
*/}
<a
  href={getRelativeLocaleUrl(other, path)}
  hreflang={other}
  class="inline-flex h-8 items-center rounded-full px-2 text-sm font-medium whitespace-nowrap text-foreground transition-glow hover:glow-lamp"
>
  <span lang={other} class="xs:hidden">
    {t("header.switchLocale.short")}
  </span>
  <span lang={other} class="hidden xs:inline">
    {t("header.switchLocale.label")}
  </span>
  <span class="sr-only">{t("header.switchLocale")}</span>
</a>
