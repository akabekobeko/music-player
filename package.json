{
  "name": "music-player",
  "productName": "MusicPlayer",
  "author": "akabeko",
  "version": "1.0.0",
  "description": "A music player for local audio libraries",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "vite build --config src/main/vite.config.ts",
    "build:preload": "vite build --config src/preload/vite.config.ts",
    "build:renderer": "vite build --config src/renderer/vite.config.ts",
    "sync-targets": "node scripts/sync-electron-targets.ts",
    "typecheck": "tsc --build && tsc -p tsconfig.scripts.json",
    "package": "npm run build && electron-builder",
    "init": "node scripts/init.ts",
    "test": "vitest",
    "check": "biome check",
    "fix": "biome check --fix",
    "shadcn": "node scripts/shadcn.ts",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@akabeko/music-metadata-editor": "^1.0.2",
    "@base-ui/react": "^1.7.0",
    "@biomejs/biome": "^2.5.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "lefthook": "^2.1.10",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.2",
    "react-router": "^8.3.0",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
