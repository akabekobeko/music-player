{
  "name": "music-player",
  "author": "akabeko",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "vite build --config src/main/vite.config.ts",
    "build:preload": "vite build --config src/preload/vite.config.ts",
    "build:renderer": "vite build --config src/renderer/vite.config.ts",
    "sync-targets": "node scripts/sync-electron-targets.mjs",
    "typecheck": "tsc --build",
    "package": "npm run build && electron-builder",
    "init": "node scripts/init.mjs",
    "test": "vitest",
    "check": "biome check",
    "fix": "biome check --fix",
    "shadcn": "node scripts/shadcn.mjs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@base-ui/react": "^1.4.1",
    "@biomejs/biome": "^2.4.14",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "lefthook": "^2.1.6",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  }
}
