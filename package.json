{
  "name": "music-player",
  "author": "akabeko",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "vite build --config src/main/vite.config.ts",
    "build:preload": "vite build --config src/preload/vite.config.ts",
    "build:renderer": "vite build --config src/renderer/vite.config.ts",
    "sync-targets": "node scripts/sync-electron-targets.ts",
    "typecheck": "tsc --build && tsc -p tsconfig.scripts.json",
    "package": "npm run build && electron-builder",
    "init": "node scripts/init.ts",
    "test": "vitest",
    "check": "biome check",
    "fix": "biome check --fix",
    "shadcn": "node scripts/shadcn.ts",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@biomejs/biome": "^2.5.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "lefthook": "^2.1.9",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
