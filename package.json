{
  "name": "parade",
  "productName": "Parade",
  "author": "akabeko",
  "version": "1.3.0",
  "description": "A music player for local audio libraries",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "demo": "node scripts/demo.ts",
    "demo:assets": "node scripts/demo-assets.ts",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "vite build --config src/main/vite.config.ts",
    "build:preload": "vite build --config src/preload/vite.config.ts",
    "build:renderer": "vite build --config src/renderer/vite.config.ts",
    "sync-targets": "node scripts/sync-electron-targets.ts",
    "typecheck": "tsc --build && tsc -p tsconfig.scripts.json",
    "package": "npm run build && electron-builder",
    "icons": "sips -s format png build/icon.svg --out build/icon.png && sips -z 824 824 -p 1024 1024 build/icon.png --out build/icon-mac.png",
    "init": "node scripts/init.ts",
    "test": "vitest",
    "check": "biome check",
    "fix": "biome check --fix",
    "shadcn": "node scripts/shadcn.ts",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@akabeko/music-metadata-editor": "^1.2.0",
    "@base-ui/react": "^1.8.0",
    "@biomejs/biome": "^2.5.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "lefthook": "^2.1.16",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.13.3",
    "react-router": "^8.4.0",
    "shadcn": "^4.21.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
